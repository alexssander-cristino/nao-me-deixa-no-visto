{
  "name": "nao-me-deixa-no-visto",
  "productName": "Não Me Deixa no Visto",
  "version": "2.0.0",
  "description": "Terror em primeira pessoa: explore, sobreviva e fuja de Valdirene",
  "main": "main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "electron": "^45.4.1"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": true,
        "name": "NaoMeDeixaNoVisto"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32"
          ],
          "config": {}
        }
      ]
    }
  }
}
