{
  "name": "nao-me-deixa-no-visto",
  "productName": "Não Me Deixa no Visto",
  "version": "1.0.0",
  "description": "Jogo de terror em primeira pessoa com Valdirene",
  "main": "main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.0",
    "@electron-forge/maker-squirrel": "^7.10.0",
    "@electron-forge/maker-zip": "^7.10.0",
    "electron": "^39.0.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": true,
        "name": "NaoMeDeixaNoVisto"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "nao_me_deixa_no_visto",
            "authors": "Desenvolvedor",
            "description": "Ela Não Aceita o Fim"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32"
          ],
          "config": {}
        }
      ]
    }
  }
}